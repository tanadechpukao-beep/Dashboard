# Discord Token จาก https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID ของบอท (Application ID)
CLIENT_ID=your_client_id_here

# Groq API Key (ไม่บังคับ - ถ้าไม่ใส่จะใช้ regex อย่างเดียว)
# สมัครฟรีที่ https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Firebase Service Account (JSON string ทั้งก้อนใน 1 บรรทัด)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
